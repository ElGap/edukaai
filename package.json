  "license": "MIT",
  "private": false,
  "bin": {
    "edukaai": "./bin/cli.js"
  },
  "main": "./bin/cli.js",
  "files": [
    ".output/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
