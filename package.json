  },
  "homepage": "https://github.com/elgap/edukaai#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@huggingface/hub": "^2.10.5",
    "@nuxt/ui": "^4.5.1",
    "@pinia/nuxt": "^0.11.3",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "chart.js": "^4.4.9",
    "drizzle-orm": "^0.45.1",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "vue-chartjs": "^5.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "drizzle-kit": "^0.31.9",
    "nuxt": "^4.3.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.29",
    "vue-router": "^4.5.0"
  }
